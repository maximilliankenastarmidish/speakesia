<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Speakesia | Master Indonesian with Confidence</title>
    <!-- Tailwind CSS CDN for modern styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased">

    <!-- Header / Navbar -->
    <header class="bg-white border-b border-slate-100 sticky top-0 z-50">
        <div class="max-w-6xl mx-auto px-6 h-20 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="bg-emerald-600 text-white w-10 h-10 rounded-xl flex items-center justify-center font-bold text-xl shadow-md">S</div>
                <span class="text-xl font-extrabold tracking-tight text-slate-900">Speakesia</span>
            </div>
            <div class="flex items-center space-x-4">
                <a href="#contact" class="hidden sm:inline-flex text-sm font-medium text-slate-600 hover:text-emerald-600 transition">Programs</a>
                <a href="#booking" class="bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-sm transition">Book Trial</a>
            </div>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="max-w-6xl mx-auto px-6 py-16 md:py-24 grid md:grid-cols-2 gap-12 items-center">
        <div class="space-y-6">
            <span class="bg-emerald-100 text-emerald-800 text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider">BIPA Language Academy</span>
            <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 leading-tight">
                Master Indonesian for Expats & Professionals.
            </h1>
            <p class="text-lg text-slate-600 leading-relaxed">
                Personalized, conversational Indonesian (Bahasa Indonesia) training tailored for international speakers. From absolute beginner survival phrases to professional fluency.
            </p>
            <div class="flex flex-col sm:flex-row space-y-3 sm:space-y-0 sm:space-x-4 pt-2">
                <a href="https://wa.me/YOUR_WHATSAPP_NUMBER" target="_blank" class="bg-emerald-600 hover:bg-emerald-700 text-white font-medium px-6 py-3.5 rounded-xl text-center shadow-md flex items-center justify-center space-x-2 transition">
                    <i class="fa-brands fa-whatsapp text-lg"></i>
                    <span>Chat on WhatsApp</span>
                </a>
                <a href="https://meet.google.com/your-virtual-office-link" target="_blank" class="bg-white hover:bg-slate-100 text-slate-800 border border-slate-200 font-medium px-6 py-3.5 rounded-xl text-center flex items-center justify-center space-x-2 transition">
                    <i class="fa-solid fa-video text-emerald-600"></i>
                    <span>Virtual Office (GMeet)</span>
                </a>
            </div>
        </div>
        <div class="relative">
            <div class="bg-gradient-to-tr from-emerald-600 to-teal-400 rounded-3xl p-2 shadow-2xl">
                <div class="bg-white rounded-2xl p-8 space-y-6">
                    <div class="flex items-center space-x-4">
                        <div class="w-12 h-12 bg-emerald-100 rounded-full flex items-center justify-center text-emerald-600 font-bold text-lg">ID</div>
                        <div>
                            <h3 class="font-bold text-slate-900">Live 1-on-1 Sessions</h3>
                            <p class="text-sm text-slate-500">Customized curriculum for your goals</p>
                        </div>
                    </div>
                    <hr class="border-slate-100">
                    <div class="space-y-3 text-sm text-slate-600">
                        <div class="flex items-center space-x-3">
                            <i class="fa-solid fa-check text-emerald-600"></i>
                            <span>Practical conversation focus (no boring textbooks)</span>
                        </div>
                        <div class="flex items-center space-x-3">
                            <i class="fa-solid fa-check text-emerald-600"></i>
                            <span>Flexible weekend schedules (WIB)</span>
                        </div>
                        <div class="flex items-center space-x-3">
                            <i class="fa-solid fa-check text-emerald-600"></i>
                            <span>CEFR-aligned BIPA 1 to BIPA 3 tracks</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Programs / Available Languages -->
    <section id="programs" class="bg-white py-16 border-y border-slate-100">
        <div class="max-w-6xl mx-auto px-6 space-y-12">
            <div class="text-center max-w-2xl mx-auto space-y-3">
                <h2 class="text-3xl font-bold tracking-tight text-slate-900">Learning Tracks</h2>
                <p class="text-slate-600">Designed for foreign speakers entering the Indonesian culture and economy.</p>
            </div>
            <div class="grid md:grid-cols-2 gap-8">
                <!-- Track 1 -->
                <div class="border border-slate-200 rounded-2xl p-8 space-y-4 hover:shadow-lg transition bg-slate-50/50">
                    <div class="w-10 h-10 bg-emerald-600 text-white rounded-xl flex items-center justify-center font-bold">EN</div>
                    <h3 class="text-xl font-bold text-slate-900">For English Speakers</h3>
                    <p class="text-slate-600 text-sm leading-relaxed">
                        Optimized programs translating directly from English thought patterns into natural Indonesian sentence structures, focus areas include expat life, travel, and business.
                    </p>
                    <span class="inline-block text-emerald-700 font-semibold text-sm pt-2">Active Enrollment →</span>
                </div>
                <!-- Track 2 -->
                <div class="border border-slate-200 rounded-2xl p-8 space-y-4 hover:shadow-lg transition bg-slate-50/50">
                    <div class="w-10 h-10 bg-slate-800 text-white rounded-xl flex items-center justify-center font-bold">中</div>
                    <h3 class="text-xl font-bold text-slate-900">For Mandarin Speakers (Coming Soon)</h3>
                    <p class="text-slate-600 text-sm leading-relaxed">
                        Specialized modules and vocabulary bridges designed for Chinese professionals and business owners operating across Indonesian industrial corridors.
                    </p>
                    <span class="inline-block text-slate-400 font-semibold text-sm pt-2">Opening Soon</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-slate-900 text-slate-400 py-12">
        <div class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0">
            <div class="flex items-center space-x-3">
                <div class="bg-emerald-600 text-white w-8 h-8 rounded-lg flex items-center justify-center font-bold">S</div>
                <span class="text-white font-bold tracking-tight">Speakesia Academy</span>
            </div>
            <p class="text-xs">&copy; 2026 Speakesia. All rights reserved. Powered by digital independence.</p>
        </div>
    </footer>

</body>
</html>
